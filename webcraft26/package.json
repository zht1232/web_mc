{
  "name": "webcraft26",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "tsc --noEmit && vite build",
    "assets": "node scripts/build-assets.mjs && node scripts/build-states.mjs && node scripts/build-mobs.mjs",
    "states": "node scripts/build-states.mjs",
    "verify:states": "node research/verify-geometry.mjs",
    "bundle": "node scripts/export-bundle.mjs --out G:/ck-web26/export --with-assets",
    "preview": "vite preview --host 0.0.0.0 --port 5174"
  },
  "devDependencies": {
    "playwright": "^1.50.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
